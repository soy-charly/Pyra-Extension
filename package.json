{
  "name": "zenvik-language",
  "displayName": "Zenvik Language",
  "description": "Syntax highlighting and compiler commands for the Zenvik language.",
  "version": "0.1.0",
  "publisher": "pyra-language",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/soy-charly/Pyra-Extension.git"
  },
  "icon": "Zenvik-Logo.png",
  "files": [
    "extension.js",
    "language-features.js",
    "language-configuration.json",
    "Zenvik-Logo.png",
    "icons/**",
    "LICENCE",
    "README.md",
    "snippets/**",
    "syntaxes/**"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:zenvik"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zenvik",
        "aliases": [
          "Zenvik",
          "zenvik"
        ],
        "extensions": [
          ".zenvik"
        ],
        "icon": {
          "light": "./icons/Zenvik-Logo.svg",
          "dark": "./icons/Zenvik-Logo.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zenvik",
        "scopeName": "source.zenvik",
        "path": "./syntaxes/zenvik.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zenvik",
        "path": "./snippets/zenvik.json"
      }
    ],
    "commands": [
      {
        "command": "zenvik.compileFile",
        "title": "Zenvik: Compile File"
      },
      {
        "command": "zenvik.runExecutable",
        "title": "Zenvik: Run Executable"
      },
      {
        "command": "zenvik.checkFile",
        "title": "Zenvik: Check File"
      }
    ],
    "configuration": {
      "title": "Zenvik",
      "properties": {
        "zenvikLanguage.compilerPath": {
          "type": "string",
          "default": "zenvik",
          "description": "Path to the Zenvik compiler executable."
        }
      }
    }
  }
}
