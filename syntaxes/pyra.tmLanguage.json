{
  "scopeName": "source.pyra",
  "patterns": [
    {
      "name": "comment.line.number-sign.pyra",
      "match": "#.*$"
    },
    {
      "name": "meta.function.definition.pyra",
      "begin": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.pyra"
        },
        "2": {
          "name": "entity.name.function.pyra"
        },
        "3": {
          "name": "punctuation.section.arguments.begin.pyra"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.arguments.end.pyra"
        }
      },
      "end": "\\)",
      "patterns": [
        {
          "include": "#parameters"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    {
      "include": "#expressions"
    }
  ],
  "repository": {
    "parameters": {
      "patterns": [
        {
          "name": "variable.parameter.pyra",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.sequence.pyra",
          "match": ","
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "name": "string.quoted.double.pyra",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.pyra"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.pyra"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.pyra",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.pyra",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.pyra"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.pyra"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.pyra",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.numeric.pyra",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        },
        {
          "name": "constant.language.pyra",
          "match": "\\b(?:True|False|None)\\b"
        },
        {
          "name": "keyword.control.pyra",
          "match": "\\b(?:if|elif|else|while|for|in|def|return|break|continue|and|or|not)\\b"
        },
        {
          "name": "keyword.operator.pyra",
          "match": "(?:\\*\\*|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|[+*/%<>=-])"
        },
        {
          "name": "punctuation.section.block.pyra",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.sequence.pyra",
          "match": "[\\[\\](),:;]"
        },
        {
          "name": "entity.name.function.call.pyra",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.pyra",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
