{
  "scopeName": "source.zenvik",
  "patterns": [
    {
      "name": "comment.line.number-sign.zenvik",
      "match": "#.*$"
    },
    {
      "name": "meta.function.definition.zenvik",
      "begin": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.zenvik"
        },
        "2": {
          "name": "entity.name.function.zenvik"
        },
        "3": {
          "name": "punctuation.section.arguments.begin.zenvik"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.arguments.end.zenvik"
        }
      },
      "end": "\\)",
      "patterns": [
        {
          "include": "#parameters"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    {
      "include": "#expressions"
    }
  ],
  "repository": {
    "parameters": {
      "patterns": [
        {
          "name": "variable.parameter.zenvik",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.sequence.zenvik",
          "match": ","
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "name": "string.quoted.double.zenvik",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.zenvik"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.zenvik"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.zenvik",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.zenvik",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.zenvik"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.zenvik"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.zenvik",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.numeric.zenvik",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        },
        {
          "name": "constant.language.zenvik",
          "match": "\\b(?:True|False|None)\\b"
        },
        {
          "name": "keyword.control.zenvik",
          "match": "\\b(?:if|elif|else|while|for|in|def|return|break|continue|and|or|not)\\b"
        },
        {
          "name": "keyword.operator.zenvik",
          "match": "(?:\\*\\*|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|[+*/%<>=-])"
        },
        {
          "name": "punctuation.section.block.zenvik",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.sequence.zenvik",
          "match": "[\\[\\](),:;]"
        },
        {
          "name": "entity.name.function.call.zenvik",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.zenvik",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
